# VayuGuard Production Environment Configuration
# Copy to .env and update with production values

# ============ DATABASE ============
DB_HOST=postgres
DB_PORT=5432
DB_NAME=vayuguard
DB_USER=vayuguard_user
DB_PASSWORD=CHANGEME_STRONG_PASSWORD
DB_POOL_MAX=100
DB_POOL_MIN=10

# ============ BACKEND SERVICE ============
NODE_ENV=production
PORT=5000
JWT_SECRET=CHANGEME_STRONG_JWT_SECRET
ML_SERVICE_URL=http://ml-service:8001
LOG_LEVEL=info

# ============ SECURITY ============
CORS_ORIGIN=https://yourdomain.com
TLS_CERT_PATH=/etc/nginx/ssl/cert.pem
TLS_KEY_PATH=/etc/nginx/ssl/key.pem

# ============ FRONTEND ============
VITE_API_URL=https://yourdomain.com/api

# ============ DATA PIPELINE (WAQI) ============
WAQI_API_KEY=CHANGEME_WAQI_API_KEY
CPCB_API_URL=https://cpcb.api.endpoint.com
CPCB_API_KEY=CHANGEME_CPCB_API_KEY
INGEST_INTERVAL_MINUTES=15
INGEST_SOURCE=all

# ============ MONITORING ============
GF_ADMIN_PASSWORD=CHANGEME_GRAFANA_PASSWORD
PROMETHEUS_RETENTION_DAYS=30

# ============ BACKUP ============
BACKUP_ENABLED=true
BACKUP_SCHEDULE=0 2 * * *
BACKUP_RETENTION_DAYS=30
BACKUP_STORAGE_PATH=/backups

# ============ DEPLOYMENT ============
ENVIRONMENT=production
DEPLOYMENT_VERSION=v1.0.0
ENABLE_MONITORING=true
ENABLE_BACKUP=true
ENABLE_ROLLBACK=true
